{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definition",
    "cohorts",
    "component_source_coverage",
    "independent_human_review_completed",
    "ranking_supported",
    "method"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "version",
        "design",
        "cohorts",
        "definition_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "design": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "cohorts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "role",
              "period",
              "selection_rule",
              "units"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "period": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date"
                  },
                  "end": {
                    "type": "string",
                    "format": "date"
                  }
                }
              },
              "selection_rule": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "units": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "family_id",
                    "release_train",
                    "firmware_build",
                    "hardware_model",
                    "deployment",
                    "service",
                    "support_window",
                    "component_sources"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "family_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "release_train": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "firmware_build": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "hardware_model": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "deployment": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "service": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "enabled"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        "enabled": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        }
                      }
                    },
                    "support_window": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "start",
                            "end"
                          ],
                          "properties": {
                            "start": {
                              "type": "string",
                              "format": "date"
                            },
                            "end": {
                              "type": "string",
                              "format": "date"
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "component_sources": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "format": "uri",
                        "maxLength": 2048
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "cohorts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "period",
          "units",
          "selected_scope_units",
          "confirmed_build_denominator",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "period": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "vendor",
                "name",
                "state",
                "missing_dimensions",
                "component_evidence",
                "source_checks",
                "build_inventory_denominator",
                "comparison_rate"
              ],
              "properties": {
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "family_id",
                    "release_train",
                    "firmware_build",
                    "hardware_model",
                    "deployment",
                    "service",
                    "support_window",
                    "component_sources"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "family_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "release_train": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "firmware_build": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "hardware_model": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "deployment": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "service": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "enabled"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        "enabled": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        }
                      }
                    },
                    "support_window": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "start",
                            "end"
                          ],
                          "properties": {
                            "start": {
                              "type": "string",
                              "format": "date"
                            },
                            "end": {
                              "type": "string",
                              "format": "date"
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "component_sources": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "format": "uri",
                        "maxLength": 2048
                      }
                    }
                  }
                },
                "vendor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                },
                "state": {
                  "const": "blocked"
                },
                "missing_dimensions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "\\S"
                  }
                },
                "component_evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_url",
                      "source_sha256",
                      "observed_at",
                      "component_scope",
                      "components",
                      "locators",
                      "latest_retrieval_matches_analyzed_snapshot"
                    ],
                    "properties": {
                      "source_url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "source_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "observed_at": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "component_scope": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      },
                      "components": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2048,
                            "pattern": "\\S"
                          }
                        }
                      },
                      "locators": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        }
                      },
                      "latest_retrieval_matches_analyzed_snapshot": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "source_checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_url",
                      "outcome",
                      "checked_at",
                      "error_code"
                    ],
                    "properties": {
                      "source_url": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      },
                      "outcome": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      },
                      "checked_at": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "error_code": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "build_inventory_denominator": {
                  "type": "null"
                },
                "comparison_rate": {
                  "type": "null"
                }
              }
            }
          },
          "selected_scope_units": {
            "type": "integer",
            "minimum": 1
          },
          "confirmed_build_denominator": {
            "type": "null"
          },
          "state": {
            "const": "blocked"
          }
        }
      }
    },
    "component_source_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vendor",
          "analyzed_sources",
          "sources_with_component_references",
          "source_errors",
          "state"
        ],
        "properties": {
          "vendor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "analyzed_sources": {
            "type": "integer",
            "minimum": 0
          },
          "sources_with_component_references": {
            "type": "integer",
            "minimum": 0
          },
          "source_errors": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "enum": [
              "references_only",
              "no_component_references_retained"
            ]
          }
        }
      }
    },
    "independent_human_review_completed": {
      "const": false
    },
    "ranking_supported": {
      "const": false
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "publication": {
      "type": "object"
    },
    "generated_at": {
      "type": "string"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definition",
    "cohorts",
    "component_source_coverage",
    "independent_human_review_completed",
    "ranking_supported",
    "method"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "version",
        "design",
        "cohorts",
        "definition_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "design": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "cohorts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "role",
              "period",
              "selection_rule",
              "units"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "period": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date"
                  },
                  "end": {
                    "type": "string",
                    "format": "date"
                  }
                }
              },
              "selection_rule": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "units": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "family_id",
                    "release_train",
                    "firmware_build",
                    "hardware_model",
                    "deployment",
                    "service",
                    "support_window",
                    "component_sources"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "family_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "release_train": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "firmware_build": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "hardware_model": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "deployment": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "service": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "enabled"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        "enabled": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        }
                      }
                    },
                    "support_window": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "start",
                            "end"
                          ],
                          "properties": {
                            "start": {
                              "type": "string",
                              "format": "date"
                            },
                            "end": {
                              "type": "string",
                              "format": "date"
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "component_sources": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "format": "uri",
                        "maxLength": 2048
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "cohorts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "period",
          "units",
          "selected_scope_units",
          "confirmed_build_denominator",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "period": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "vendor",
                "name",
                "state",
                "missing_dimensions",
                "component_evidence",
                "source_checks",
                "build_inventory_denominator",
                "comparison_rate"
              ],
              "properties": {
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "family_id",
                    "release_train",
                    "firmware_build",
                    "hardware_model",
                    "deployment",
                    "service",
                    "support_window",
                    "component_sources"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "family_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "release_train": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "firmware_build": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "hardware_model": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "deployment": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "service": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "enabled"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        "enabled": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        }
                      }
                    },
                    "support_window": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "start",
                            "end"
                          ],
                          "properties": {
                            "start": {
                              "type": "string",
                              "format": "date"
                            },
                            "end": {
                              "type": "string",
                              "format": "date"
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "component_sources": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "format": "uri",
                        "maxLength": 2048
                      }
                    }
                  }
                },
                "vendor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                },
                "state": {
                  "const": "blocked"
                },
                "missing_dimensions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "\\S"
                  }
                },
                "component_evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_url",
                      "source_sha256",
                      "observed_at",
                      "component_scope",
                      "components",
                      "locators",
                      "latest_retrieval_matches_analyzed_snapshot"
                    ],
                    "properties": {
                      "source_url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "source_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "observed_at": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "component_scope": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      },
                      "components": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2048,
                            "pattern": "\\S"
                          }
                        }
                      },
                      "locators": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        }
                      },
                      "latest_retrieval_matches_analyzed_snapshot": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "source_checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_url",
                      "outcome",
                      "checked_at",
                      "error_code"
                    ],
                    "properties": {
                      "source_url": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      },
                      "outcome": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      },
                      "checked_at": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "error_code": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "build_inventory_denominator": {
                  "type": "null"
                },
                "comparison_rate": {
                  "type": "null"
                }
              }
            }
          },
          "selected_scope_units": {
            "type": "integer",
            "minimum": 1
          },
          "confirmed_build_denominator": {
            "type": "null"
          },
          "state": {
            "const": "blocked"
          }
        }
      }
    },
    "component_source_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vendor",
          "analyzed_sources",
          "sources_with_component_references",
          "source_errors",
          "state"
        ],
        "properties": {
          "vendor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "analyzed_sources": {
            "type": "integer",
            "minimum": 0
          },
          "sources_with_component_references": {
            "type": "integer",
            "minimum": 0
          },
          "source_errors": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "enum": [
              "references_only",
              "no_component_references_retained"
            ]
          }
        }
      }
    },
    "independent_human_review_completed": {
      "const": false
    },
    "ranking_supported": {
      "const": false
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "publication": {
      "type": "object"
    },
    "generated_at": {
      "type": "string"
    },
    "build_pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "version",
        "role",
        "component",
        "cve_id",
        "targets",
        "independent_human_review_completed",
        "build_denominator",
        "rate_comparison",
        "method",
        "selection_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "version": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "component": {
          "const": "OpenSSH"
        },
        "cve_id": {
          "const": "CVE-2024-6387"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "vendor",
              "product_literal",
              "firmware_build",
              "source_url",
              "cve_id",
              "selector",
              "expression",
              "fields",
              "state",
              "verified_inventory"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "vendor": {
                "type": "string"
              },
              "product_literal": {
                "type": "string"
              },
              "firmware_build": {
                "type": "string"
              },
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "cve_id": {
                "type": "string"
              },
              "selector": {
                "enum": [
                  "version_expression",
                  "product_version_context"
                ]
              },
              "expression": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "state",
                    "value",
                    "evidence"
                  ],
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "state": {
                      "enum": [
                        "publisher_statement",
                        "unknown"
                      ]
                    },
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "source_url",
                          "source_sha256",
                          "observed_at",
                          "locator"
                        ],
                        "properties": {
                          "source_url": {
                            "type": "string",
                            "format": "uri"
                          },
                          "source_sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "observed_at": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "locator": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "state": {
                "const": "partial_public_evidence"
              },
              "verified_inventory": {
                "const": false
              },
              "inventory_proposal_template": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "schema_version",
                  "kind",
                  "target",
                  "artifacts",
                  "claims"
                ],
                "properties": {
                  "schema_version": {
                    "const": 1
                  },
                  "kind": {
                    "const": "build_inventory_proposal"
                  },
                  "target": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "vendor",
                      "product",
                      "firmware_build",
                      "component",
                      "role"
                    ],
                    "properties": {
                      "vendor": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      },
                      "product": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      },
                      "firmware_build": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      },
                      "component": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      },
                      "role": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      }
                    }
                  },
                  "artifacts": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "file_name",
                        "sha256",
                        "source_url",
                        "observed_at",
                        "kind",
                        "redistribution",
                        "rights_basis"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                        },
                        "file_name": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "source_url": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2048,
                              "pattern": "\\S",
                              "format": "uri"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "observed_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "kind": {
                          "enum": [
                            "publisher_manifest",
                            "publisher_sbom",
                            "publisher_advisory",
                            "publisher_release_notes",
                            "source_archive",
                            "image_metadata",
                            "device_export",
                            "historical_capture"
                          ]
                        },
                        "redistribution": {
                          "enum": [
                            "unknown",
                            "restricted",
                            "permission_confirmed"
                          ]
                        },
                        "rights_basis": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2048,
                              "pattern": "\\S"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    }
                  },
                  "claims": {
                    "type": "array",
                    "minItems": 9,
                    "maxItems": 9,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "field",
                        "state",
                        "value",
                        "evidence"
                      ],
                      "properties": {
                        "field": {
                          "enum": [
                            "firmware_reference",
                            "component_version",
                            "package_patch_id",
                            "hardware_model",
                            "image_digest",
                            "service_configuration",
                            "historical_support_window",
                            "historical_download_availability",
                            "build_component_binding"
                          ]
                        },
                        "state": {
                          "enum": [
                            "unknown",
                            "publisher_statement",
                            "artifact_observation"
                          ]
                        },
                        "value": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2048,
                              "pattern": "\\S"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "evidence": {
                          "type": "array",
                          "maxItems": 32,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "artifact_id",
                              "locator"
                            ],
                            "properties": {
                              "artifact_id": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                              },
                              "locator": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2048,
                                "pattern": "\\S"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "source_check": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "outcome",
                  "checked_at",
                  "error_code"
                ],
                "properties": {
                  "outcome": {
                    "type": "string"
                  },
                  "checked_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "error_code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "independent_human_review_completed": {
          "const": false
        },
        "build_denominator": {
          "type": "null"
        },
        "rate_comparison": {
          "type": "null"
        },
        "method": {
          "type": "string"
        },
        "selection_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}

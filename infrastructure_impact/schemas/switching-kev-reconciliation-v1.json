    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "definition_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mapping_version": {
      "const": "switching-kev-exact-pairs-v1"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "impact-target-import-manifest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "expected_target_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 174
    },
    "max_document_bytes": {
      "const": 3000000,
      "type": "integer"
    },
    "max_input_bytes": {
      "const": 40000000,
      "type": "integer"
    },
    "max_received_bytes": {
      "const": 80000000,
      "type": "integer"
    },
    "max_attempts_per_target": {
      "const": 2,
      "type": "integer"
    },
    "max_http_attempts": {
      "const": 348,
      "type": "integer"
    },
    "min_request_interval_seconds": {
      "const": 1,
      "type": "integer"
    },
    "allow_redirects": {
      "const": false,
      "type": "boolean"
    },
    "max_receipt_bytes": {
      "const": 2000000,
      "type": "integer"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vendor": {
            "enum": [
              "aruba",
              "cisco"
            ]
          },
          "advisory_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "fetch_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "discovery_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "cve_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
            },
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "source_observed_at": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "retained_collection_checked_at": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        },
        "required": [
          "vendor",
          "advisory_id",
          "fetch_url",
          "discovery_url",
          "source_sha256",
          "cve_ids",
          "source_observed_at",
          "retained_collection_checked_at"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 174
    }
  },
  "required": [
    "format",
    "schema_version",
    "profile_id",
    "version",
    "expected_target_count",
    "max_document_bytes",
    "max_input_bytes",
    "max_received_bytes",
    "max_attempts_per_target",
    "max_http_attempts",
    "min_request_interval_seconds",
    "allow_redirects",
    "max_receipt_bytes",
    "targets"
  ],
  "additionalProperties": false
}

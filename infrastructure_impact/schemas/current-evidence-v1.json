{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "availability",
    "publication",
    "generated_at",
    "policies",
    "decisions",
    "issues",
    "counts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "availability": {
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "publication": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "advisory_schema_version": {
              "type": "integer",
              "const": 2
            }
          },
          "required": [
            "id",
            "advisory_schema_version"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vendor",
          "policy_id",
          "version",
          "fingerprint",
          "reason_text"
        ],
        "properties": {
          "vendor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "policy_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reason_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "vendor",
          "policy_id",
          "policy_version",
          "policy_fingerprint",
          "target_key",
          "disposition",
          "reason",
          "reason_text",
          "proofs",
          "target"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "vendor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "policy_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "policy_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "policy_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "target_key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "disposition": {
            "const": "excluded_from_current"
          },
          "reason": {
            "const": "reviewed_representation_scope_conflict"
          },
          "reason_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "proofs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_url",
                "source_sha256",
                "evidence_id",
                "source_observed_at",
                "locator"
              ],
              "properties": {
                "source_url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "maxLength": 2048
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "evidence_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "source_observed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "maxItems": 20,
            "minItems": 1
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vendor",
              "advisory_id",
              "revision_id",
              "source_url",
              "sha256"
            ],
            "properties": {
              "vendor": {
                "type": "string",
                "minLength": 1
              },
              "advisory_id": {
                "type": "string",
                "minLength": 1
              },
              "source_url": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "revision_id": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                ]
              }
            }
          }
        }
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vendor",
          "policy_id",
          "target_key",
          "code"
        ],
        "properties": {
          "vendor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "policy_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "target_key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "code": {
            "const": "proof_unresolved"
          }
        }
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "retained_total",
        "excluded"
      ],
      "properties": {
        "current": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retained_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "excluded": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "availability": {
            "const": "available"
          }
        }
      },
      "then": {
        "properties": {
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "current",
              "retained_total",
              "excluded"
            ],
            "properties": {
              "current": {
                "type": "integer",
                "minimum": 0
              },
              "retained_total": {
                "type": "integer",
                "minimum": 0
              },
              "excluded": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "current",
              "retained_total",
              "excluded"
            ],
            "properties": {
              "current": {
                "type": "null"
              },
              "retained_total": {
                "type": "null"
              },
              "excluded": {
                "type": "null"
              }
            }
          },
          "policies": {
            "maxItems": 0
          },
          "decisions": {
            "maxItems": 0
          },
          "issues": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_at",
    "review_method",
    "sample_strategy",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "review_method": {
      "type": "string",
      "minLength": 1
    },
    "sample_strategy": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "vendor",
          "source_url",
          "source_sha256",
          "cve_id",
          "product_pattern",
          "expected_status",
          "source_locator",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "vendor": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "minLength": 1
          },
          "product_pattern": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "version_contains": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "cve_id": {
            "type": "string",
            "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
          },
          "expected_status": {
            "enum": [
              "affected",
              "unaffected",
              "fixed",
              "investigating",
              "unknown",
              "partially_mitigated",
              "recommended",
              "conflicting"
            ]
          },
          "expected_scope": {
            "enum": [
              "cve_specific",
              "bulletin_shared"
            ]
          },
          "remediation_availability": {
            "enum": [
              "planned",
              "vendor_reports_fixed",
              "partial_mitigation",
              "unavailable",
              "no_fix_planned",
              "not_a_fix"
            ]
          },
          "forbidden_statuses": {
            "type": "array",
            "items": {
              "enum": [
                "affected",
                "unaffected",
                "fixed",
                "investigating",
                "unknown",
                "partially_mitigated",
                "recommended",
                "conflicting"
              ]
            },
            "uniqueItems": true
          },
          "claim_context": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}

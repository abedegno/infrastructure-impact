{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "impact-target-import-preview",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "manifest_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "source_config_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "normalizer_fingerprints": {
      "type": "object",
      "properties": {
        "aruba": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{16}|[0-9a-f]{64})$"
        },
        "cisco": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{16}|[0-9a-f]{64})$"
        }
      },
      "required": [
        "aruba",
        "cisco"
      ],
      "additionalProperties": false
    },
    "baseline_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vendor": {
            "enum": [
              "aruba",
              "cisco"
            ]
          },
          "advisory_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "fetch_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "discovery_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "cve_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
            },
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "source_observed_at": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "retained_collection_checked_at": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "before_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "uniqueItems": true
          }
        },
        "required": [
          "vendor",
          "advisory_id",
          "fetch_url",
          "discovery_url",
          "source_sha256",
          "cve_ids",
          "source_observed_at",
          "retained_collection_checked_at",
          "before_keys"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 174
    }
  },
  "required": [
    "format",
    "schema_version",
    "profile_id",
    "profile_version",
    "manifest_fingerprint",
    "source_config_fingerprint",
    "normalizer_fingerprints",
    "baseline_fingerprint",
    "fingerprint",
    "observed_at",
    "targets"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publication",
    "generated_at",
    "bootstrap",
    "cohorts",
    "changes",
    "full"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "advisory_schema_version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "advisory_schema_version": {
          "const": 2
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "bootstrap": {
      "$ref": "#/$defs/part"
    },
    "cohorts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/part"
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "full": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "const": "snapshot.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^data/[a-f0-9]{64}\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8000000
        }
      }
    }
  }
}

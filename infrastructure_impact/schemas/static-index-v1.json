{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publication",
    "generated_at",
    "bootstrap",
    "cohorts",
    "changes",
    "full"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "advisory_schema_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "advisory_schema_version": {
          "const": 2
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "bootstrap": {
      "$ref": "#/$defs/part"
    },
    "cohorts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/part"
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "full": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "const": "snapshot.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "switching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "kev_entries",
        "evidence_metadata",
        "has_score_availability"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/part"
        },
        "inputs": {
          "$ref": "#/$defs/part"
        },
        "claims": {
          "$ref": "#/$defs/claim_entries"
        },
        "kev_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "evidence_metadata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "has_score_availability": {
          "type": "boolean"
        },
        "summary_fragments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parts",
            "sha256",
            "bytes"
          ],
          "properties": {
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/part"
              }
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128000000
            }
          }
        },
        "claim_catalog": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/part"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "summary"
          ]
        },
        {
          "required": [
            "summary_fragments"
          ]
        }
      ],
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "claims"
              ]
            },
            {
              "required": [
                "claim_catalog"
              ]
            }
          ]
        }
      ]
    },
    "current_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "report",
        "retained"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "report": {
          "$ref": "#/$defs/part"
        },
        "retained": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision_ids",
              "cve_ids",
              "part"
            ],
            "properties": {
              "decision_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "cve_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
                }
              },
              "part": {
                "$ref": "#/$defs/part"
              }
            }
          }
        }
      }
    },
    "switching_analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/part"
        },
        "summary_fragments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parts",
            "sha256",
            "bytes"
          ],
          "properties": {
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/part"
              }
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128000000
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "summary"
          ]
        },
        {
          "required": [
            "summary_fragments"
          ]
        }
      ]
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^data/[a-f0-9]{64}\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8000000
        }
      }
    },
    "claim_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_ids",
        "part"
      ],
      "properties": {
        "claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "part": {
          "$ref": "#/$defs/part"
        }
      }
    },
    "claim_entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_entry"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "review_method": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "scope"
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "prefix": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "vendor",
          "group",
          "prefix",
          "source_url",
          "reviewed_at",
          "rationale"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "taxonomy_version",
    "review_method",
    "groups",
    "rules"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Infrastructure Impact release listing metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vendor",
    "source_url",
    "title",
    "product",
    "version",
    "platforms",
    "reported_published_at",
    "artifact_filename",
    "artifact_sha256",
    "availability_basis",
    "evidence_locator",
    "limitations",
    "adapter_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reported_published_at": {
      "type": "string",
      "format": "date"
    },
    "artifact_filename": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "availability_basis": {
      "const": "publisher_dated_listing"
    },
    "evidence_locator": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    }
  }
}

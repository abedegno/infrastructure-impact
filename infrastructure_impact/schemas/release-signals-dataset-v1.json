{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "documents", "coverage"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      },
      "maxItems": 512
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      },
      "maxItems": 1024
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "enum": [
        "release",
        "withdrawn",
        "deferred",
        "corrective_respin",
        "field_notice",
        "recommended",
        "bug_list"
      ]
    },
    "vendor": {
      "enum": ["cisco", "aruba", "arista"]
    },
    "train": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "release": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "train", "start", "end", "status", "expected_releases", "reason"],
      "properties": {
        "vendor": {
          "$ref": "#/$defs/vendor"
        },
        "train": {
          "$ref": "#/$defs/train"
        },
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        },
        "status": {
          "enum": ["partial", "blocked", "not_collected"]
        },
        "expected_releases": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "vendor",
        "train",
        "release",
        "related_release",
        "date",
        "platforms",
        "statement",
        "bug_ids",
        "source_locator"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "vendor": {
          "$ref": "#/$defs/vendor"
        },
        "train": {
          "$ref": "#/$defs/train"
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/release"
            },
            {
              "type": "null"
            }
          ]
        },
        "related_release": {
          "anyOf": [
            {
              "$ref": "#/$defs/release"
            },
            {
              "type": "null"
            }
          ]
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "bug_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "maxItems": 4096,
          "uniqueItems": true
        },
        "source_locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "previous_revision_id",
        "source_url",
        "source_sha256",
        "retrieved_at",
        "capture_method",
        "events"
      ],
      "properties": {
        "revision_id": {
          "$ref": "#/$defs/digest"
        },
        "previous_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri"
        },
        "source_sha256": {
          "$ref": "#/$defs/digest"
        },
        "retrieved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "capture_method": {
          "enum": ["http_response", "rendered_capture"]
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "maxItems": 4096
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cases",
    "leads_truncated",
    "independent_human_review_completed",
    "method"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lead_id",
          "vendor",
          "product",
          "kind",
          "cve_ids",
          "state",
          "next_action",
          "evidence",
          "related_case_ids",
          "earlier_document_counter_evidence",
          "checklist",
          "alternative_explanations",
          "concealment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "lead_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "vendor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "product": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "cve_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          },
          "state": {
            "const": "review_required"
          },
          "next_action": {
            "enum": [
              "review_counter_evidence",
              "verify_change_and_scope",
              "establish_availability_and_disclosure"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_url",
                "source_sha256",
                "observed_at",
                "publisher_date_claim"
              ],
              "properties": {
                "source_url": {
                  "type": "string",
                  "format": "uri"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "observed_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "publisher_date_claim": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "related_case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          },
          "earlier_document_counter_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_url",
                "source_sha256",
                "observed_at",
                "publisher_date_claim"
              ],
              "properties": {
                "source_url": {
                  "type": "string",
                  "format": "uri"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "observed_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "publisher_date_claim": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "checklist": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "state",
                "question"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                },
                "state": {
                  "const": "not_established"
                },
                "question": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                }
              }
            }
          },
          "alternative_explanations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          },
          "concealment": {
            "const": "not_established"
          },
          "details": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "investigation": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "version",
                  "reviewed_at",
                  "review_method",
                  "source_state",
                  "disposition",
                  "summary",
                  "search_scope",
                  "remaining_evidence",
                  "uncollected_search_leads",
                  "independent_human_review_completed",
                  "concealment"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "reviewed_at": {
                    "type": "string",
                    "format": "date"
                  },
                  "review_method": {
                    "type": "string"
                  },
                  "source_state": {
                    "enum": [
                      "matches_reviewed_sources",
                      "source_changed_review_required"
                    ]
                  },
                  "disposition": {
                    "enum": [
                      "release_availability_unresolved",
                      "security_linkage_unresolved",
                      "counter_evidence_to_nondisclosure",
                      "source_changed_review_required"
                    ]
                  },
                  "summary": {
                    "type": "string"
                  },
                  "search_scope": {
                    "type": "string"
                  },
                  "remaining_evidence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "uncollected_search_leads": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "independent_human_review_completed": {
                    "const": false
                  },
                  "concealment": {
                    "const": "not_established"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "leads_truncated": {
      "type": "boolean"
    },
    "independent_human_review_completed": {
      "const": false
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "publication": {
      "type": "object"
    },
    "generated_at": {
      "type": "string"
    }
  }
}

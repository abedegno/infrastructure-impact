{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "independent_human_review_completed",
    "vendors",
    "method"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "const": "whole_publication"
    },
    "independent_human_review_completed": {
      "const": false
    },
    "vendors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vendor",
          "name",
          "advisories",
          "metadata_only_advisories",
          "without_cve_advisories",
          "without_cve_sources",
          "without_cve_sources_truncated",
          "freshness",
          "configured_sources",
          "source_error_count",
          "source_errors",
          "source_errors_truncated",
          "archive_pending",
          "archive_failed",
          "review_total",
          "review_raw_passes",
          "review_section_matches",
          "review_unresolved",
          "portfolio_completeness"
        ],
        "properties": {
          "vendor": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "advisories": {
            "type": "integer",
            "minimum": 0
          },
          "metadata_only_advisories": {
            "type": "integer",
            "minimum": 0
          },
          "without_cve_advisories": {
            "type": "integer",
            "minimum": 0
          },
          "without_cve_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "source_url",
                "source_sha256"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "source_url": {
                  "type": "string",
                  "format": "uri"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "maxItems": 100
          },
          "without_cve_sources_truncated": {
            "type": "boolean"
          },
          "freshness": {
            "enum": [
              "fresh",
              "stale",
              "not_checked"
            ]
          },
          "configured_sources": {
            "type": "integer",
            "minimum": 0
          },
          "source_error_count": {
            "type": "integer",
            "minimum": 0
          },
          "source_errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_url",
                "error_code",
                "checked_at"
              ],
              "properties": {
                "source_url": {
                  "type": "string",
                  "format": "uri"
                },
                "error_code": {
                  "type": "string"
                },
                "checked_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "maxItems": 100
          },
          "source_errors_truncated": {
            "type": "boolean"
          },
          "archive_pending": {
            "type": "integer",
            "minimum": 0
          },
          "archive_failed": {
            "type": "integer",
            "minimum": 0
          },
          "review_total": {
            "type": "integer",
            "minimum": 0
          },
          "review_raw_passes": {
            "type": "integer",
            "minimum": 0
          },
          "review_section_matches": {
            "type": "integer",
            "minimum": 0
          },
          "review_unresolved": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "cve_id",
                "source_url",
                "outcome"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "cve_id": {
                  "type": "string",
                  "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
                },
                "source_url": {
                  "type": "string",
                  "format": "uri"
                },
                "outcome": {
                  "enum": [
                    "source_missing",
                    "source_revision_unreviewed",
                    "product_scope_missing",
                    "disagreement"
                  ]
                }
              }
            }
          },
          "portfolio_completeness": {
            "const": "not_established"
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "declared_product_families",
              "declared_history_scope",
              "declared_gaps",
              "capabilities",
              "configured_sources",
              "observed_formats",
              "publisher_date_range",
              "documents_without_publisher_date",
              "archives",
              "unsupported_sources",
              "access_blocked_sources",
              "other_error_sources"
            ],
            "properties": {
              "declared_product_families": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "declared_history_scope": {
                "type": "string"
              },
              "declared_gaps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "configured_sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_url",
                    "role",
                    "kind",
                    "per_pass_limit"
                  ],
                  "properties": {
                    "source_url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "role": {
                      "enum": [
                        "vendors",
                        "pinned",
                        "release_documents",
                        "archives"
                      ]
                    },
                    "kind": {
                      "type": "string"
                    },
                    "per_pass_limit": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    }
                  }
                }
              },
              "observed_formats": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "format",
                    "advisories"
                  ],
                  "properties": {
                    "format": {
                      "type": "string"
                    },
                    "advisories": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "publisher_date_range": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "earliest",
                  "latest"
                ],
                "properties": {
                  "earliest": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "latest": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "documents_without_publisher_date": {
                "type": "integer",
                "minimum": 0
              },
              "archives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_url",
                    "kind",
                    "page_limit",
                    "document_limit",
                    "pages",
                    "documents",
                    "known_queue_exhausted",
                    "publisher_date_range"
                  ],
                  "properties": {
                    "source_url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "page_limit": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "document_limit": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "pages": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "pending",
                        "done",
                        "not_applicable",
                        "error"
                      ],
                      "properties": {
                        "pending": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "done": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "not_applicable": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "error": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "documents": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "pending",
                        "done",
                        "not_applicable",
                        "error"
                      ],
                      "properties": {
                        "pending": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "done": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "not_applicable": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "error": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "known_queue_exhausted": {
                      "type": "boolean"
                    },
                    "publisher_date_range": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "earliest",
                        "latest"
                      ],
                      "properties": {
                        "earliest": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "latest": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              "unsupported_sources": {
                "type": "integer",
                "minimum": 0
              },
              "access_blocked_sources": {
                "type": "integer",
                "minimum": 0
              },
              "other_error_sources": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "method": {
      "type": "string"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "advisory_schema_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "advisory_schema_version": {
          "const": 2
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infrastructure-impact:advisory:2",
  "title": "Infrastructure Impact normalized advisory v2",
  "type": "object",
  "required": [
    "schema_version",
    "vendor",
    "advisory_id",
    "title",
    "adapter_version",
    "source_url",
    "source_format",
    "document_status",
    "cves",
    "assessments",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "vendor": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "advisory_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "advisory_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_format": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "string",
          "format": "local-date-time"
        }
      ]
    },
    "updated_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "string",
          "format": "local-date-time"
        }
      ]
    },
    "reported_fix_date": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "document_status": {
      "enum": [
        "unknown",
        "final",
        "interim",
        "draft",
        "published",
        "rejected"
      ]
    },
    "cves": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cve"
      },
      "uniqueItems": true
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assessment"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    },
    "evidence_id": {
      "type": "integer",
      "minimum": 1
    },
    "revision_id": {
      "type": "integer",
      "minimum": 1
    },
    "observed_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "first_fixed": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/first_fixed"
      }
    },
    "publisher_chronology": {
      "$ref": "#/$defs/publisherChronology"
    },
    "disclosure_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parser": {
          "const": "cisco-owned-disclosure-v1"
        },
        "advisory_id": {
          "type": "string",
          "minLength": 1
        },
        "advisory_type": {
          "enum": [
            "security_hardening",
            "unknown"
          ]
        },
        "initial_published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_precision": {
          "enum": [
            "day",
            "timestamp",
            "unknown"
          ]
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "classification": {
              "enum": [
                null,
                "pre_risk_based",
                "risk_based",
                "outside_policy"
              ]
            },
            "basis": {
              "enum": [
                "unknown",
                "explicit",
                "dated_rule",
                "date_and_type_rule",
                "third_party_exception"
              ]
            },
            "locator": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "classification",
            "basis",
            "locator"
          ]
        },
        "grouping_wording": {
          "type": [
            "string",
            "null"
          ]
        },
        "grouping_locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "highest_cvss_wording": {
          "type": [
            "string",
            "null"
          ]
        },
        "highest_cvss_locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "umbrella_cves": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cve_id": {
                "type": "string",
                "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
              },
              "cwe_id": {
                "type": "string",
                "pattern": "^CWE-[0-9]+$"
              },
              "highest_cvss": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "cve_id",
              "cwe_id",
              "highest_cvss",
              "locator"
            ]
          }
        },
        "bug_count": {
          "type": "null"
        },
        "bug_count_status": {
          "const": "not_disclosed"
        },
        "bundle": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "const": "security_hardening"
                },
                "initial_published_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "date_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "advisory_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "cve_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
                  }
                }
              },
              "required": [
                "id",
                "kind",
                "initial_published_at",
                "date_locator",
                "advisory_ids",
                "cve_ids"
              ]
            }
          ]
        }
      },
      "required": [
        "parser",
        "advisory_id",
        "advisory_type",
        "initial_published_at",
        "date_precision",
        "method",
        "grouping_wording",
        "grouping_locator",
        "highest_cvss_wording",
        "highest_cvss_locator",
        "umbrella_cves",
        "bug_count",
        "bug_count_status",
        "bundle"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "cve": {
      "type": "string",
      "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
    },
    "assessment": {
      "type": "object",
      "required": [
        "cve_id",
        "product_id",
        "product",
        "status",
        "scope",
        "versions",
        "remediations",
        "exposure",
        "evidence_locator"
      ],
      "properties": {
        "cve_id": {
          "$ref": "#/$defs/cve"
        },
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "product_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "affected",
            "unaffected",
            "fixed",
            "partially_mitigated",
            "investigating",
            "unknown",
            "recommended",
            "conflicting"
          ]
        },
        "scope": {
          "enum": [
            "cve_specific",
            "bulletin_shared"
          ]
        },
        "source_statuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string"
              },
              "expression": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "affected",
                  "unaffected",
                  "unknown",
                  "fixed"
                ]
              },
              "lessThan": {
                "type": "string"
              },
              "lessThanOrEqual": {
                "type": "string"
              },
              "versionType": {
                "type": "string"
              }
            },
            "anyOf": [
              {
                "required": [
                  "version"
                ]
              },
              {
                "required": [
                  "expression"
                ]
              }
            ],
            "additionalProperties": true
          }
        },
        "remediations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "availability": {
                "enum": [
                  "vendor_reports_fixed",
                  "planned",
                  "partial_mitigation",
                  "no_fix_planned",
                  "unavailable",
                  "not_a_fix",
                  "unknown"
                ]
              },
              "details": {
                "type": "string"
              }
            }
          }
        },
        "exposure": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "evidence_locator": {
          "type": "string",
          "minLength": 1
        },
        "product_context": {
          "type": "array"
        },
        "relationship": {
          "type": [
            "object",
            "null"
          ]
        },
        "extensions": {
          "type": "object"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identifiers": {
          "type": "object",
          "properties": {
            "cpe": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "purl": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "first_fixed": {
      "type": "object",
      "required": [
        "method",
        "evidence_state",
        "scope",
        "cve_ids",
        "family",
        "product",
        "product_ids",
        "train",
        "train_expression",
        "fixed_versions",
        "disposition",
        "source_locator"
      ],
      "properties": {
        "method": {
          "enum": [
            "stated_table",
            "openvuln_api",
            "inferred_next_release"
          ]
        },
        "evidence_state": {
          "enum": [
            "publisher_stated",
            "inferred_candidate"
          ]
        },
        "scope": {
          "enum": [
            "bulletin_shared",
            "cve_specific",
            "unresolved"
          ]
        },
        "cve_ids": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/cve"
          }
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "product": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "product_ids": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "train": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "train_expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "fixed_versions": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "disposition": {
          "enum": [
            "fixed",
            "migrate",
            "unknown",
            "conflicting"
          ]
        },
        "source_locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "additionalProperties": false
    },
    "publisherChronology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "advisory_id",
        "cve_ids",
        "effective_initial",
        "original_published_at",
        "original_updated_at",
        "html_source",
        "csaf_source",
        "rss_source",
        "observations",
        "issues"
      ],
      "properties": {
        "method": {
          "const": "arista_owned_html_initial_v1"
        },
        "advisory_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "cve_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
          }
        },
        "effective_initial": {
          "type": "string",
          "format": "date"
        },
        "original_published_at": {
          "type": "string",
          "format": "date-time"
        },
        "original_updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "html_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "sha256",
            "retrieved_at"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://www\\.arista\\.com/(?:en/support/advisories-notices/security-advisory/\\d+-security-advisory-\\d+|assets/data/SecurityAdvisories/CSAF/arista_networks_security_advisory_\\d+_CSAF\\.json|en/support/advisories-notices/security-advisory-rss)$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "retrieved_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        },
        "csaf_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "sha256",
            "retrieved_at"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://www\\.arista\\.com/(?:en/support/advisories-notices/security-advisory/\\d+-security-advisory-\\d+|assets/data/SecurityAdvisories/CSAF/arista_networks_security_advisory_\\d+_CSAF\\.json|en/support/advisories-notices/security-advisory-rss)$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "retrieved_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        },
        "rss_source": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "sha256",
                "retrieved_at"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://www\\.arista\\.com/(?:en/support/advisories-notices/security-advisory/\\d+-security-advisory-\\d+|assets/data/SecurityAdvisories/CSAF/arista_networks_security_advisory_\\d+_CSAF\\.json|en/support/advisories-notices/security-advisory-rss)$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "retrieved_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "observations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "literal",
              "value",
              "source",
              "locator",
              "revision",
              "summary"
            ],
            "properties": {
              "event": {
                "enum": [
                  "html_revision",
                  "csaf_initial",
                  "csaf_current",
                  "csaf_revision",
                  "rss_publication"
                ]
              },
              "literal": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "string",
                    "format": "date-time"
                  }
                ]
              },
              "source": {
                "enum": [
                  "html",
                  "csaf",
                  "rss"
                ]
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "revision": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2000
              },
              "summary": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2000
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "csaf_current_revision_conflict",
              "rss_item_not_observed",
              "rss_not_supplied"
            ]
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infrastructure-impact.org/schemas/coverage-gaps-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "scope",
    "last_run",
    "sources",
    "triage",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor",
        "sample_limit"
      ],
      "properties": {
        "vendor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sample_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "last_run": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "started_at",
            "finished_at",
            "outcome",
            "imported",
            "failures"
          ],
          "properties": {
            "scope": {
              "enum": [
                "global_persisted_pipeline_run"
              ]
            },
            "started_at": {
              "type": "string"
            },
            "finished_at": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "outcome": {
              "enum": [
                "ok",
                "error",
                "running",
                "interrupted",
                "unknown",
                "partial"
              ]
            },
            "imported": {
              "type": "integer",
              "minimum": 0
            },
            "failures": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vendor",
          "source_url",
          "kind",
          "configured",
          "configuration_sections",
          "archive_id",
          "invocation",
          "health",
          "history",
          "queue",
          "current",
          "triage",
          "evidence",
          "observed_window",
          "budgets"
        ],
        "properties": {
          "vendor": {
            "type": "string"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string"
          },
          "configured": {
            "type": "boolean"
          },
          "configuration_sections": {
            "type": "array",
            "items": {
              "enum": [
                "vendors",
                "pinned",
                "release_documents",
                "archives",
                "switching_sources"
              ]
            }
          },
          "archive_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "invocation": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "run_id",
                  "study_id",
                  "requested_window",
                  "started_at",
                  "checked_at",
                  "enumeration_state",
                  "error_code",
                  "enumerated_identities",
                  "duplicate_entries",
                  "diagnostics",
                  "expected_total"
                ],
                "properties": {
                  "run_id": {
                    "type": "string"
                  },
                  "study_id": {
                    "type": "string"
                  },
                  "requested_window": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "start_date",
                      "end_date"
                    ],
                    "properties": {
                      "start_date": {
                        "type": "string"
                      },
                      "end_date": {
                        "type": "string"
                      }
                    }
                  },
                  "started_at": {
                    "type": "string"
                  },
                  "checked_at": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "enumeration_state": {
                    "enum": [
                      "unstable",
                      "blocked",
                      "enumerated",
                      "partial",
                      "not_configured"
                    ]
                  },
                  "error_code": {
                    "anyOf": [
                      {
                        "enum": [
                          "auth_not_configured",
                          "auth_rejected",
                          "access_denied",
                          "rate_limited",
                          "service_unavailable",
                          "network_error",
                          "response_too_large",
                          "invalid_json",
                          "unsupported_response",
                          "credential_response_rejected",
                          "url_rejected",
                          "redirect_rejected",
                          "http_error",
                          "request_state_unresolved",
                          "publisher_scope_unavailable",
                          "retained_source_missing",
                          "access_verification_required",
                          "source_missing",
                          "redirect_target_missing",
                          "edge_access_denied",
                          "unsupported_or_invalid_document",
                          "collection_error"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "enumerated_identities": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "duplicate_entries": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "diagnostics": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "listing_duplicate_links",
                        "overlapping_pages",
                        "missing_document_link",
                        "publisher_total_missing",
                        "publisher_total_changed",
                        "publisher_total_mismatch",
                        "publisher_page_limit",
                        "entries_without_links",
                        "pagination_cycle",
                        "pre_2022_history_not_enumerated"
                      ]
                    }
                  },
                  "expected_total": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "health": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "checked_at",
                  "outcome",
                  "error_code"
                ],
                "properties": {
                  "checked_at": {
                    "type": "string"
                  },
                  "outcome": {
                    "enum": [
                      "ok",
                      "error",
                      "not_applicable",
                      "reprocessed",
                      "unchanged",
                      "imported",
                      "unknown",
                      "partial"
                    ]
                  },
                  "error_code": {
                    "anyOf": [
                      {
                        "enum": [
                          "auth_not_configured",
                          "auth_rejected",
                          "access_denied",
                          "rate_limited",
                          "service_unavailable",
                          "network_error",
                          "response_too_large",
                          "invalid_json",
                          "unsupported_response",
                          "credential_response_rejected",
                          "url_rejected",
                          "redirect_rejected",
                          "http_error",
                          "request_state_unresolved",
                          "publisher_scope_unavailable",
                          "retained_source_missing",
                          "access_verification_required",
                          "source_missing",
                          "redirect_target_missing",
                          "edge_access_denied",
                          "unsupported_or_invalid_document",
                          "collection_error"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "history": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "collection_attempts",
              "collection_errors",
              "parser_replays"
            ],
            "properties": {
              "collection_attempts": {
                "type": "integer",
                "minimum": 0
              },
              "collection_errors": {
                "type": "integer",
                "minimum": 0
              },
              "parser_replays": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "attempts",
                  "recovered",
                  "not_applicable",
                  "still_unsupported",
                  "not_retained"
                ],
                "properties": {
                  "attempts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "recovered": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "not_applicable": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "still_unsupported": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "not_retained": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "queue": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "discovered",
              "pending",
              "done",
              "not_applicable",
              "error",
              "retrieved",
              "retrieval_failures",
              "unsupported",
              "other_errors"
            ],
            "properties": {
              "discovered": {
                "type": "integer",
                "minimum": 0
              },
              "pending": {
                "type": "integer",
                "minimum": 0
              },
              "done": {
                "type": "integer",
                "minimum": 0
              },
              "not_applicable": {
                "type": "integer",
                "minimum": 0
              },
              "error": {
                "type": "integer",
                "minimum": 0
              },
              "retrieved": {
                "type": "integer",
                "minimum": 0
              },
              "retrieval_failures": {
                "type": "integer",
                "minimum": 0
              },
              "unsupported": {
                "type": "integer",
                "minimum": 0
              },
              "other_errors": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "current": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parsed_advisories",
              "parsed_representations",
              "unknown_aliases",
              "publisher_total",
              "portfolio_completeness",
              "model_classification",
              "human_review",
              "publisher_date_range",
              "retained_unlinked_notices"
            ],
            "properties": {
              "parsed_advisories": {
                "type": "integer",
                "minimum": 0
              },
              "parsed_representations": {
                "type": "integer",
                "minimum": 0
              },
              "unknown_aliases": {
                "type": "integer",
                "minimum": 0
              },
              "publisher_total": {
                "type": "null"
              },
              "portfolio_completeness": {
                "enum": [
                  "not_established"
                ]
              },
              "model_classification": {
                "enum": [
                  "unknown"
                ]
              },
              "human_review": {
                "enum": [
                  "not_established"
                ]
              },
              "publisher_date_range": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "earliest",
                  "latest"
                ],
                "properties": {
                  "earliest": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "latest": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "retained_unlinked_notices": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "triage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sampled",
              "unsampled",
              "parsed_preview",
              "recognized_notice",
              "retained_unlinked_notice",
              "other_not_applicable",
              "not_retained",
              "error"
            ],
            "properties": {
              "sampled": {
                "type": "integer",
                "minimum": 0
              },
              "unsampled": {
                "type": "integer",
                "minimum": 0
              },
              "parsed_preview": {
                "type": "integer",
                "minimum": 0
              },
              "recognized_notice": {
                "type": "integer",
                "minimum": 0
              },
              "retained_unlinked_notice": {
                "type": "integer",
                "minimum": 0
              },
              "other_not_applicable": {
                "type": "integer",
                "minimum": 0
              },
              "not_retained": {
                "type": "integer",
                "minimum": 0
              },
              "error": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "available",
              "retained",
              "truncated"
            ],
            "properties": {
              "available": {
                "type": "integer",
                "minimum": 0
              },
              "retained": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidence_id",
                    "source_url",
                    "sha256",
                    "observed_at"
                  ],
                  "properties": {
                    "evidence_id": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "source_url": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "uri"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "observed_at": {
                      "type": "string"
                    }
                  }
                }
              },
              "truncated": {
                "type": "boolean"
              }
            }
          },
          "observed_window": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "observed_at",
                  "entries",
                  "unique_links",
                  "entries_without_links",
                  "historical_availability"
                ],
                "properties": {
                  "observed_at": {
                    "type": "string"
                  },
                  "entries": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unique_links": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "entries_without_links": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "historical_availability": {
                    "enum": [
                      "unknown"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "budgets": {
            "type": "object",
            "required": [
              "feed_limit",
              "page_limit",
              "document_limit"
            ],
            "properties": {
              "feed_limit": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "page_limit": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "document_limit": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "sampled",
        "unsampled",
        "truncated",
        "documents"
      ],
      "properties": {
        "available": {
          "type": "integer",
          "minimum": 0
        },
        "sampled": {
          "type": "integer",
          "minimum": 0
        },
        "unsampled": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "documents": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vendor",
              "source_url",
              "resolved_url",
              "source_sha256",
              "outcome",
              "error_code",
              "cves",
              "assessments"
            ],
            "properties": {
              "vendor": {
                "type": "string"
              },
              "source_url": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "resolved_url": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outcome": {
                "enum": [
                  "parsed_preview",
                  "recognized_notice",
                  "retained_unlinked_notice",
                  "other_not_applicable",
                  "not_retained",
                  "error"
                ]
              },
              "error_code": {
                "anyOf": [
                  {
                    "enum": [
                      "auth_not_configured",
                      "auth_rejected",
                      "access_denied",
                      "rate_limited",
                      "service_unavailable",
                      "network_error",
                      "response_too_large",
                      "invalid_json",
                      "unsupported_response",
                      "credential_response_rejected",
                      "url_rejected",
                      "redirect_rejected",
                      "http_error",
                      "request_state_unresolved",
                      "publisher_scope_unavailable",
                      "retained_source_missing",
                      "access_verification_required",
                      "source_missing",
                      "redirect_target_missing",
                      "edge_access_denied",
                      "unsupported_or_invalid_document",
                      "collection_error"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cves": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "assessments": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "enum": [
          "source_rows_nonadditive",
          "publisher_totals_unknown",
          "aliases_unresolved_unless_retained_identity",
          "preview_not_ingestion_or_human_review",
          "retrieval_time_not_historical_availability",
          "parsed_not_applicability",
          "queue_not_applicable_not_notice_proof",
          "historical_attempts_not_current_failures",
          "global_last_run_not_vendor_allocated",
          "no_network_or_credentials"
        ]
      }
    }
  }
}

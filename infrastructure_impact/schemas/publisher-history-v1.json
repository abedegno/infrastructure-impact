{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vendor": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "publisher_date": {
                  "type": "string",
                  "format": "date"
                },
                "kind": {
                  "enum": [
                    "initial_document_release",
                    "cve_references_added"
                  ]
                },
                "cve_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
                  }
                },
                "source_locator": {
                  "type": "string"
                }
              },
              "required": [
                "publisher_date",
                "kind",
                "cve_ids",
                "source_locator"
              ]
            }
          },
          "product": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "enum": [
              "parsed",
              "unsupported_or_invalid_document"
            ]
          }
        },
        "required": [
          "vendor",
          "source_url",
          "source_sha256",
          "observed_at",
          "events",
          "product",
          "version",
          "state"
        ]
      }
    },
    "method": {
      "type": "string"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "advisory_schema_version": {
          "const": 2
        }
      },
      "required": [
        "id",
        "advisory_schema_version"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "documents",
    "method"
  ]
}
